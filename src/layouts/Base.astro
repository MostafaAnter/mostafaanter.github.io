---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { profile } from '../lib/content';
import sgUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props { title?: string; description?: string }
const title = Astro.props.title ?? `${profile.name} — ${profile.role}`;
const description = Astro.props.description ?? 'Senior Android Engineer and Technical Lead with 10+ years building scalable apps for 100M+ users. Kotlin, Jetpack Compose, clean architecture and CI/CD.';
const url = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL('/og.png', Astro.site).href;
const site = Astro.site!.href;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person', '@id': `${site}#person`,
      name: profile.name, jobTitle: profile.role, url: site,
      image: new URL('/img/portrait.jpg', site).href,
      email: `mailto:${profile.contact.email}`,
      address: { '@type': 'PostalAddress', addressLocality: 'Cairo', addressCountry: 'EG' },
      worksFor: { '@type': 'Organization', name: 'The Weather Company' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Assiut University' },
      knowsLanguage: ['English', 'Arabic'],
      knowsAbout: ['Kotlin', 'Jetpack Compose', 'Android', 'Clean Architecture', 'CI/CD', 'Server-Driven UI'],
      sameAs: [profile.links.linkedin, profile.links.github, profile.links.stackoverflow, profile.links.twitter, profile.links.blog],
    },
    { '@type': 'WebSite', '@id': `${site}#website`, url: site, name: `${profile.name} — Portfolio`, inLanguage: 'en', publisher: { '@id': `${site}#person` } },
    { '@type': 'ProfilePage', '@id': `${site}#profilepage`, url: site, name: title, description, inLanguage: 'en', isPartOf: { '@id': `${site}#website` }, mainEntity: { '@id': `${site}#person` }, primaryImageOfPage: { '@type': 'ImageObject', url: og } },
  ],
};
const gc = profile.analytics?.goatcounter; // empty = no analytics script
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#0b0f14" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mostafa Anter, Senior Android Engineer and Technical Lead" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preload" as="font" type="font/woff2" href={sgUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interUrl} crossorigin />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline>
      // Saved choice wins, otherwise follow the system. Runs before paint to avoid a flash.
      (function () {
        var s = localStorage.getItem('theme');
        document.documentElement.dataset.theme = s || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        // Motion gate: reveals start hidden ONLY when animation is allowed AND will load.
        var calm = matchMedia('(prefers-reduced-motion: reduce)').matches || matchMedia('(prefers-reduced-data: reduce)').matches;
        if (!calm) {
          document.documentElement.classList.add('motion-ok');
          // Failsafe: if the motion script has not taken over, show everything.
          setTimeout(function () { if (!window.__motionReady) document.documentElement.classList.remove('motion-ok'); }, 3500);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    {gc && <script is:inline async data-goatcounter={`https://${gc}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>}
  </body>
</html>
