---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { profile } from '../lib/content';

interface Props { title?: string; description?: string }
const title = Astro.props.title ?? `${profile.name} — ${profile.role}`;
const description = Astro.props.description ?? 'Senior Android Engineer and Technical Lead with 10+ years building scalable apps for 100M+ users. Kotlin, Jetpack Compose, clean architecture, CI/CD and AI-accelerated engineering.';
const url = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL('/og.png', Astro.site).href;
const person = {
  '@context': 'https://schema.org', '@type': 'Person',
  name: profile.name, jobTitle: profile.role, url: Astro.site?.href,
  image: new URL('/img/portrait.jpg', Astro.site).href,
  email: `mailto:${profile.contact.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Cairo', addressCountry: 'EG' },
  worksFor: { '@type': 'Organization', name: 'The Weather Company' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Assiut University' },
  knowsLanguage: ['English', 'Arabic'],
  knowsAbout: ['Android', 'Kotlin', 'Jetpack Compose', 'Clean Architecture', 'CI/CD', 'Server-Driven UI'],
  sameAs: [profile.links.linkedin, profile.links.github, profile.links.stackoverflow, profile.links.twitter, profile.links.blog],
};
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#0b0f14" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>
      // Saved choice wins, otherwise follow the system. Runs before paint to avoid a flash.
      (function () {
        var s = localStorage.getItem('theme');
        document.documentElement.dataset.theme = s || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        // Motion gate: reveals start hidden ONLY when animation is allowed AND will load.
        var calm = matchMedia('(prefers-reduced-motion: reduce)').matches || matchMedia('(prefers-reduced-data: reduce)').matches;
        if (!calm) {
          document.documentElement.classList.add('motion-ok');
          // Failsafe: if the motion script has not taken over, show everything.
          setTimeout(function () { if (!window.__motionReady) document.documentElement.classList.remove('motion-ok'); }, 3500);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
