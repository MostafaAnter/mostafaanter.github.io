---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Mostafa Anter" description="This page does not exist.">
  <meta slot="head" name="robots" content="noindex" />
  <main id="main" class="wrap nf">
    <span class="eyebrow">404</span>
    <h1>Page not found</h1>
    <p>The page you were looking for does not exist or has moved.</p>
    <a class="btn primary" href="/">Back to the portfolio</a>
    <nav aria-label="Sections" class="links">
      <a href="/#about">About</a><a href="/#experience">Experience</a><a href="/#skills">Skills</a><a href="/#projects">Projects</a><a href="/#certificates">Certificates</a><a href="/#contact">Contact</a>
    </nav>
  </main>
</Base>
<style>
  .nf { min-height: 100svh; display: grid; align-content: center; justify-items: start; gap: .5rem; }
  h1 { font-size: clamp(2.5rem, 8vw, 5rem); }
  p { color: var(--muted); margin-bottom: 1.5rem; }
  .links { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; margin-top: 1.5rem; }
  .links a { display: inline-flex; align-items: center; min-height: 2.75rem; }
</style>
