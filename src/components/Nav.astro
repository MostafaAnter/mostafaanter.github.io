---
const links = [['about', 'About'], ['experience', 'Experience'], ['skills', 'Skills'], ['projects', 'Projects'], ['certificates', 'Certificates'], ['contact', 'Contact']];
---
<header class="nav" id="top">
  <div class="wrap bar">
    <a class="logo" href="#top" aria-label="Mostafa Anter, home"><svg viewBox="0 0 64 64" width="32" height="32" aria-hidden="true"><rect width="64" height="64" rx="14" fill="var(--surface-2)"/><path d="M12 46V18l20 20 20-20v28" fill="none" stroke="var(--accent)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Mostafa Anter</span></a>
    <nav aria-label="Primary" id="menu" class="menu" data-lenis-prevent>
      {links.map(([id, label]) => <a href={`#${id}`} data-nav={id}>{label}</a>)}
    </nav>
    <div class="tools">
      <button class="icon" id="theme-toggle" type="button" aria-label="Switch color theme">
        <svg class="i-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
      </button>
      <button class="icon burger" id="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div class="progress" id="progress" aria-hidden="true"></div>
</header>
<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; height: var(--nav-h); backdrop-filter: blur(14px) saturate(1.4); background: color-mix(in srgb, var(--bg) 78%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent); }
  .bar { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .logo { display: flex; align-items: center; gap: .65rem; color: var(--text); text-decoration: none; font: 600 1.05rem var(--font-display); }
  .menu { display: flex; gap: .25rem; }
  .menu a { color: var(--muted); text-decoration: none; padding: .55rem .85rem; border-radius: 999px; font-size: .95rem; font-weight: 500; transition: color .2s, background .2s; }
  .menu a:hover, .menu a[aria-current='true'] { color: var(--text); background: var(--surface-2); }
  .tools { display: flex; gap: .4rem; }
  .icon { width: 44px; height: 44px; display: grid; place-items: center; background: transparent; border: 1px solid var(--line); border-radius: 50%; transition: border-color .2s; }
  .icon:hover { border-color: var(--accent); }
  .burger { display: none; }
  :global([data-theme='dark']) .i-moon, :global([data-theme='light']) .i-sun { display: none; }
  @media (max-width: 880px) {
    .burger { display: grid; }
    .menu { position: fixed; inset: var(--nav-h) 0 auto 0; flex-direction: column; padding: 1rem 1.25rem 1.5rem; background: var(--bg); border-bottom: 1px solid var(--line); transform: translateY(-120%); visibility: hidden; transition: transform .35s var(--ease), visibility .35s; }
    .menu a { font-size: 1.15rem; padding: .9rem 1rem; }
    .menu.open { transform: none; visibility: visible; }
  }
</style>
