---
import { skills } from '../lib/content';
---
<section id="skills" aria-labelledby="skills-h">
  <div class="wrap">
    <span class="eyebrow" data-reveal>Skills</span>
    <h2 class="h2" id="skills-h" data-reveal>The toolkit behind 100M-user apps.</h2>
    <ul class="top" aria-label="Core skills">
      {skills.top.map((t) => (
        <li class="tile card" data-reveal><span class="kind">{t.group}</span><strong>{t.name}</strong></li>
      ))}
    </ul>
    <div class="groups">
      {skills.groups.filter((g) => g.items.length).map((g) => (
        <div class="group card" data-reveal>
          <h3>{g.name}</h3>
          <ul>{g.items.map((i) => <li class="chip">{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .top { list-style: none; margin: var(--space-6) 0 var(--space-4); padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
  .tile { padding: var(--space-5); min-height: 9rem; display: flex; flex-direction: column; justify-content: space-between; background: linear-gradient(160deg, var(--surface), var(--surface-2)); transition: border-color var(--dur), transform var(--dur) var(--ease), box-shadow var(--dur); }
  .tile:hover { border-color: var(--accent); transform: translateY(-3px); box-shadow: var(--shadow); }
  .kind { font: 500 var(--text-xs) var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--accent-2); }
  .tile strong { font: 700 var(--text-xl)/1.1 var(--font-display); letter-spacing: -.02em; }
  .groups { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: var(--space-4); }
  .group { padding: var(--space-5); transition: border-color var(--dur), transform var(--dur) var(--ease); }
  .group:hover { border-color: var(--accent); transform: translateY(-3px); }
  h3 { font: 500 var(--text-xs) var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: var(--space-4); }
  .group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; max-width: none; }
  @media (max-width: 880px) { .top { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 420px) { .top { grid-template-columns: 1fr; } .tile { min-height: 6rem; } }
</style>
