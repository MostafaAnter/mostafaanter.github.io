---
import { experience } from '../lib/content';
import RoleList from './RoleList.astro';
const recent = experience.roles.slice(0, 4);
const earlier = experience.roles.slice(4);
---
<section id="experience" aria-labelledby="exp-h">
  <div class="wrap">
    <span class="eyebrow" data-reveal>Experience</span>
    <h2 class="h2" id="exp-h" data-reveal>A decade across product teams and continents.</h2>
    <RoleList roles={recent} animateLine />
    <details class="earlier">
      <summary><span>Earlier roles</span><span class="count">{earlier.length} more · 2014 – 2021</span></summary>
      <RoleList roles={earlier} />
    </details>
  </div>
</section>
<style>
  .earlier { margin-top: var(--space-6); }
  summary { list-style: none; display: inline-flex; align-items: center; gap: var(--space-4); min-height: 2.75rem; padding: .6rem 1.2rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); cursor: pointer; font-weight: 600; transition: border-color var(--dur-fast); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font: 600 1.2rem/1 var(--font-mono); color: var(--accent-text); transition: transform var(--dur) var(--ease); }
  details[open] > summary::after { transform: rotate(45deg); }
  summary:hover { border-color: var(--accent); }
  .count { font: 500 var(--text-xs) var(--font-mono); color: var(--muted); }
  details > :global(.timeline) { margin-top: var(--space-6); }
</style>
