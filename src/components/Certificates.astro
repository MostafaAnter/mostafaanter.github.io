---
import { certificates, certDate } from '../lib/content';
const items = [...certificates.items].sort((a, b) => (b.date ?? '0').localeCompare(a.date ?? '0'));
const cats = ['All', ...new Set(items.map((i) => i.category))];
---
<section id="certificates" aria-labelledby="cert-h">
  <div class="wrap">
    <span class="eyebrow" data-reveal>Certificates</span>
    <h2 class="h2" id="cert-h" data-reveal>Credentials, verified.</h2>
    <div class="filters" role="group" aria-label="Filter certificates">
      {cats.map((c, i) => <button type="button" class="filter" data-cert-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}>{c}</button>)}
    </div>
    <ul class="grid">
      {items.map((c) => (
        <li class="card cert" data-cat={c.category}>
          {c.image ? (
            <button type="button" class="thumb" data-lightbox={`/${c.image}-1800`} data-title={c.title} aria-label={`View certificate: ${c.title}`}>
              <picture>
                <source type="image/avif" srcset={`/${c.image}-480.avif`} />
                <img src={`/${c.image}-480.webp`} alt={`${c.title} certificate`} width="480" loading="lazy" decoding="async" />
              </picture>
              <span class="zoom" aria-hidden="true">View</span>
            </button>
          ) : (
            <div class="thumb text" aria-hidden="true"><span>{c.issuer ?? 'Certification'}</span></div>
          )}
          <div class="info">
            <h3>{c.title}</h3>
            <p>{c.issuer ?? 'Issuer to be confirmed'}{c.date ? ` · ${certDate(c.date)}` : ''}</p>
            {'expires' in c && c.expires ? <p class="sub">Valid until {certDate(c.expires)}</p> : null}
            <div class="links">
              {'verify' in c && c.verify ? <a href={c.verify} target="_blank" rel="noopener">Verify online ↗</a> : null}
              {c.file?.endsWith('.pdf') ? <a href={`/${c.file}`} target="_blank" rel="noopener">PDF</a> : null}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
  <dialog id="lightbox" aria-label="Certificate viewer" data-lenis-prevent>
    <form method="dialog"><button class="close" aria-label="Close certificate viewer">✕</button></form>
    <img alt="" id="lightbox-img" />
    <p id="lightbox-cap"></p>
  </dialog>
</section>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: .5rem; margin: 2rem 0 1.5rem; }
  .filter { padding: .6rem 1rem; min-height: 44px; border-radius: 999px; background: transparent; border: 1px solid var(--line); font-weight: 500; }
  .filter[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1.1rem; }
  .cert { overflow: hidden; display: flex; flex-direction: column; transition: border-color .3s, transform .3s var(--ease); }
  .cert:hover { border-color: var(--accent); transform: translateY(-3px); }
  .cert[hidden] { display: none; }
  .thumb { position: relative; display: block; width: 100%; aspect-ratio: 16 / 10; padding: 0; border: 0; border-bottom: 1px solid var(--line); background: var(--surface-2); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .5s var(--ease); }
  button.thumb:hover img { transform: scale(1.05); }
  .zoom { position: absolute; inset-inline-end: .7rem; bottom: .7rem; background: var(--accent); color: var(--accent-ink); font: 600 .75rem var(--font-mono); padding: .35rem .7rem; border-radius: 999px; opacity: 0; transition: opacity .2s; }
  button.thumb:hover .zoom, button.thumb:focus-visible .zoom { opacity: 1; }
  .text { display: grid; place-items: center; text-align: center; padding: 1.5rem; background: repeating-linear-gradient(135deg, var(--surface-2), var(--surface-2) 12px, var(--surface) 12px, var(--surface) 24px); font: 500 .85rem var(--font-mono); color: var(--muted); }
  .info { padding: 1.1rem 1.3rem 1.3rem; }
  h3 { font-size: 1.1rem; line-height: 1.25; }
  .info p { margin: 0 0 .3rem; color: var(--muted); font-size: .92rem; }
  .info .sub { font: 500 .78rem var(--font-mono); }
  .links { display: flex; gap: 1rem; margin-top: .7rem; font-weight: 600; font-size: .9rem; }
  dialog { border: 1px solid var(--line); background: var(--surface); color: var(--text); border-radius: var(--radius); padding: 1rem; width: min(96vw, 1400px); max-height: 94vh; }
  dialog::backdrop { background: rgba(0, 0, 0, .8); backdrop-filter: blur(4px); }
  dialog img { width: 100%; max-height: 80vh; object-fit: contain; border-radius: 8px; background: #fff; }
  dialog p { text-align: center; margin: .8rem 0 0; color: var(--muted); }
  .close { position: absolute; inset-block-start: .6rem; inset-inline-end: .6rem; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); z-index: 2; }
</style>
