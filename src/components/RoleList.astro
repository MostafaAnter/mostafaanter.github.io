---
import { fmtMonth, yearsBetween } from '../lib/content';
interface Role { company: string; brand?: string; title: string; start: string; end: string | null; place: string; bullets: string[]; product?: { name: string; summary: string; play: string } }
const { roles, animateLine = false } = Astro.props as { roles: Role[]; animateLine?: boolean };
---
<ol class={`timeline${animateLine ? ' main' : ''}`}>
  <span class="line" aria-hidden="true"></span>
  {roles.map((r) => (
    <li class="role" data-reveal={animateLine ? '' : undefined}>
      <div class="when">
        <time>{fmtMonth(r.start)} – {r.end ? fmtMonth(r.end) : 'Present'}</time>
        <span>{yearsBetween(r.start, r.end)}</span>
      </div>
      <div class="body card">
        <h3>{r.title}</h3>
        <p class="co"><strong>{r.company}</strong>{r.brand ? <> · <span>{r.brand}</span></> : null} <span class="place">· {r.place}</span></p>
        <ul>{r.bullets.map((b) => <li>{b}</li>)}</ul>
        {r.product ? (
          <div class="product">
            <div><strong>{r.product.name}</strong><p>{r.product.summary}</p></div>
            <a class="btn" href={r.product.play} target="_blank" rel="noopener noreferrer" data-goatcounter-click={`play-${r.product.name.toLowerCase().replace(/\W+/g, '-')}`}>Google Play <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        ) : null}
      </div>
    </li>
  ))}
</ol>
<style>
  .timeline { --col: 10.5rem; list-style: none; margin: var(--space-6) 0 0; padding: 0; position: relative; display: grid; gap: var(--space-5); }
  .line { position: absolute; inset-block: .5rem; inset-inline-start: calc(var(--col) + 1.1rem); width: 2px; background: linear-gradient(var(--accent), var(--line) 30%); transform-origin: top; }
  .role { display: grid; grid-template-columns: var(--col) 1fr; gap: 2.2rem; position: relative; }
  .role::before { content: ''; position: absolute; inset-inline-start: calc(var(--col) + 1.1rem - 5px); top: 1.55rem; width: 12px; height: 12px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); }
  .when { padding-top: 1.1rem; text-align: right; font: 500 var(--text-sm)/1.4 var(--font-mono); }
  .when time { display: block; color: var(--text); white-space: nowrap; }
  .when span { color: var(--accent-2); }
  .body { padding: 1.4rem 1.6rem; }
  h3 { font-size: var(--text-xl); margin-bottom: .2rem; }
  .co { color: var(--muted); margin-bottom: .9rem; }
  .co strong { color: var(--text); }
  .place { white-space: nowrap; }
  ul { margin: 0; padding-inline-start: 1.1rem; color: var(--muted); display: grid; gap: .35rem; max-width: var(--measure); }
  ul li::marker { color: var(--accent); }
  .product { margin-top: 1.2rem; padding-top: 1.1rem; border-top: 1px dashed var(--line); display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .product p { margin: .2rem 0 0; color: var(--muted); font-size: var(--text-sm); max-width: 52ch; }
  @media (max-width: 760px) {
    .line { inset-inline-start: 7px; }
    .role { grid-template-columns: 1fr; gap: .6rem; padding-inline-start: 1.8rem; }
    .role::before { inset-inline-start: 2px; top: .35rem; }
    .when { text-align: left; padding: 0; display: flex; gap: .75rem; }
  }
</style>
