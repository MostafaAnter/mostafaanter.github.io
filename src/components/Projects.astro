---
import { projects } from '../lib/content';
const groups = [['all', 'All'], ['freelance', 'Freelance apps'], ['learning', 'Learning projects']] as const;
const count = (g: string) => (g === 'all' ? projects.length : projects.filter((p) => p.group === g).length);
const VISIBLE = 9;
---
<section id="projects" aria-labelledby="proj-h">
  <div class="wrap">
    <span class="eyebrow" data-reveal>Freelance projects</span>
    <h2 class="h2" id="proj-h" data-reveal>Apps I built as an independent developer.</h2>
    <p class="intro" data-reveal>Independent work from 2014 to 2021, written up on <a href="https://mostafa-anter-portfolio.blogspot.com/" target="_blank" rel="noopener">my blog</a>. Many of these apps have since left the Play Store, so each card links to the write-up rather than the store.</p>
    <div class="filters" role="group" aria-label="Filter projects">
      {groups.map(([g, label], i) => <button type="button" class="filter" data-filter={g} aria-pressed={i === 0 ? 'true' : 'false'}>{label} <span>{count(g)}</span></button>)}
    </div>
    <ul class="grid" id="project-grid">
      {projects.map((p, i) => (
        <li class="card item" data-group={p.group} data-extra={i >= VISIBLE ? '' : undefined}>
          <div class="meta"><span>{p.year}</span><span>{p.group === 'learning' ? 'Udacity Nanodegree' : 'Freelance'}</span></div>
          <h3>{p.title}</h3>
          <p>{p.summary}</p>
          <ul class="tech">{p.tech.map((t) => <li class="chip">{t}</li>)}</ul>
          <div class="links">
            <a href={p.url} target="_blank" rel="noopener">Read write-up <span aria-hidden="true">↗</span><span class="sr-only"> on the blog: {p.title}</span></a>
            {p.github && <a href={p.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span><span class="sr-only"> repository for {p.title}</span></a>}
          </div>
        </li>
      ))}
    </ul>
    <div class="more"><button type="button" class="btn" id="project-more" aria-expanded="false">Show all projects</button></div>
  </div>
</section>
<style>
  .intro { color: var(--muted); max-width: 62ch; margin-top: 1rem; }
  .filters { display: flex; flex-wrap: wrap; gap: .5rem; margin: 2rem 0 1.5rem; }
  .filter { padding: .6rem 1rem; min-height: 44px; border-radius: 999px; background: transparent; border: 1px solid var(--line); font-weight: 500; transition: all .2s; }
  .filter span { font: 500 .75rem var(--font-mono); color: var(--muted); margin-inline-start: .35rem; }
  .filter[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .filter[aria-pressed='true'] span { color: var(--accent-ink); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 1.1rem; }
  .item { padding: 1.4rem; display: flex; flex-direction: column; transition: border-color .3s, transform .3s var(--ease); }
  .item:hover { border-color: var(--accent); transform: translateY(-3px); }
  .item[hidden] { display: none; }
  .meta { display: flex; justify-content: space-between; font: 500 .75rem var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: .8rem; }
  h3 { font-size: 1.3rem; }
  .item p { color: var(--muted); font-size: .98rem; flex: 1; }
  .tech { list-style: none; padding: 0; margin: 0 0 1.1rem; display: flex; flex-wrap: wrap; gap: .4rem; }
  .links { display: flex; gap: 1.2rem; flex-wrap: wrap; font-weight: 600; font-size: .95rem; }
  .more { text-align: center; margin-top: 2rem; }
  .more[hidden] { display: none; }
</style>
