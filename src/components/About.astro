---
import { profile } from '../lib/content';
const v = profile.video;
---
<section id="about" aria-labelledby="about-h">
  <div class="wrap grid">
    <div>
      <span class="eyebrow" data-reveal>About</span>
      <h2 class="h2" id="about-h" data-reveal>Building apps that scale, and teams that ship.</h2>
      {profile.about.map((t: string) => <p data-reveal>{t}</p>)}
      <ul class="facts" data-reveal>
        <li><span>Based in</span> {profile.location} · working remotely worldwide</li>
        <li><span>Languages</span> {profile.languages.map((l) => `${l.name} (${l.level})`).join(' · ')}</li>
        <li><span>Education</span> B.Sc. Computer Science, Assiut University</li>
      </ul>
    </div>
    <figure class="video card" data-reveal>
      <div class="player" data-video data-webm={`/${v.webm}`} data-mp4={`/${v.mp4}`} data-captions={`/${v.captions}`} style={`aspect-ratio:${v.aspect}`}>
        <picture>
          <source type="image/avif" srcset={`/${v.poster}-480.avif 480w, /${v.poster}-960.avif 960w`} sizes="(max-width: 880px) 90vw, 460px" />
          <img src={`/${v.poster}-480.webp`} srcset={`/${v.poster}-480.webp 480w, /${v.poster}-960.webp 960w`} sizes="(max-width: 880px) 90vw, 460px" alt="Mostafa Anter introducing himself, video preview" width="680" height="720" loading="lazy" decoding="async" />
        </picture>
        <button type="button" class="play" aria-label="Play introduction video, 2 minutes">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        </button>
      </div>
      <figcaption>Hear it from me · 1:57 · captions available</figcaption>
    </figure>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  p { color: var(--muted); max-width: 60ch; }
  .facts { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: .8rem; }
  .facts li { border-top: 1px solid var(--line); padding-top: .8rem; font-size: .98rem; }
  .facts span { display: block; font: 500 .75rem var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--accent-text); margin-bottom: .15rem; }
  .video { margin: 0; padding: .6rem; overflow: hidden; position: sticky; top: calc(var(--nav-h) + 1.5rem); max-width: 480px; }
  .player { position: relative; border-radius: 12px; overflow: hidden; background: #000; }
  .player img, .player :global(video) { width: 100%; height: 100%; object-fit: cover; }
  .play { position: absolute; inset: 0; margin: auto; width: 76px; height: 76px; border-radius: 50%; border: 0; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; box-shadow: 0 0 0 10px rgba(61,220,132,.2); transition: transform .3s var(--ease); }
  .play:hover { transform: scale(1.08); }
  figcaption { padding: .8rem .4rem .3rem; color: var(--muted); font: 500 .8rem var(--font-mono); }
  @media (max-width: 880px) { .grid { grid-template-columns: 1fr; } .video { position: static; } }
</style>
